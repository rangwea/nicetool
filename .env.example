# 普通部署模板；演示启动不需要复制此文件。
ENV_FILE=.env
HOST=0.0.0.0
PORT=8000
PROJECT_PATH=
LOG_LEVEL=INFO
# Set the UI language here: zh-CN or en-US. Restart after changing.
LANGUAGE=zh-CN
TOOLS_DIR=./tools
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=nicetool
MYSQL_PASSWORD=replace-with-your-password
MYSQL_DATABASE=nicetool
MYSQL_CHARSET=utf8mb4
# 分别生成随机值：uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
STORAGE_SECRET=replace-with-a-random-secret
AUTH_ENABLED=true
AUTH_JWT_SECRET=replace-with-another-random-secret
AUTH_JWT_EXPIRES_MINUTES=30
# HTTP 本机开发使用 false，HTTPS 部署改为 true。
AUTH_REQUIRE_HTTPS_COOKIE=false
